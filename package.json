{
  "name": "@keenmate/theme-designer",
  "version": "1.0.0",
  "description": "Generate CSS variable themes for KeenMate web components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "theme",
    "css-variables",
    "color",
    "generator",
    "keenmate",
    "web-multiselect",
    "web-daterangepicker"
  ],
  "author": "KeenMate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keenmate/theme-designer.git"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  }
}
